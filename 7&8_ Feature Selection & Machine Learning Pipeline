-------------------------------------\n","# Load Reports\n","# -----------------------------------------------------\n","\n","chi = pd.read_csv(\"ChiSquare_Report.csv\")\n","anova = pd.read_csv(\"ANOVA_Report.csv\")\n","mi = pd.read_csv(\"Mutual_Information_Report.csv\")\n","rf = pd.read_csv(\"RandomForest_FeatureImportance.csv\")\n","\n","# -----------------------------------------------------\n","# Standardize Column Names\n","# -----------------------------------------------------\n","\n","chi = chi[[\"Feature\", \"P-Value\"]]\n","anova = anova[[\"Feature\", \"P-Value\"]]\n","mi = mi[[\"Feature\", \"Mutual Information Score\"]]\n","rf = rf[[\"Feature\", \"Importance\"]]\n","\n","# -----------------------------------------------------\n","# Create Master Scorecard\n","# -----------------------------------------------------\n","\n","scorecard = pd.DataFrame()\n","\n","all_features = sorted(\n","    list(\n","        set(chi[\"Feature\"])\n","        | set(anova[\"Feature\"])\n","        | set(mi[\"Feature\"])\n","        | set(rf[\"Feature\"])\n","    )\n",")\n","\n","scorecard[\"Feature\"] = all_features\n","\n","# -----------------------------------------------------\n","# Chi-Square Score\n","# -----------------------------------------------------\n","\n","scorecard = scorecard.merge(\n","    chi,\n","    on=\"Feature\",\n","    how=\"left\"\n",")\n","\n","scorecard[\"ChiSquare\"] = (\n","    scorecard[\"P-Value\"] < 0.05\n",").astype(int)\n","\n","scorecard.drop(columns=\"P-Value\", inplace=True)\n","\n","# -----------------------------------------------------\n","# ANOVA Score\n","# -----------------------------------------------------\n","\n","scorecard = scorecard.merge(\n","    anova,\n","    on=\"Feature\",\n","    how=\"left\"\n",")\n","\n","scorecard[\"ANOVA\"] = (\n","    scorecard[\"P-Value\"] < 0.05\n",").astype(int)\n","\n","scorecard.drop(columns=\"P-Value\", inplace=True)\n","\n","# -----------------------------------------------------\n","# Mutual Information Score\n","# -----------------------------------------------------\n","\n","scorecard = scorecard.merge(\n","    mi,\n","    on=\"Feature\",\n","    how=\"left\"\n",")\n","\n","mi_threshold = scorecard[\"Mutual Information Score\"].median()\n","\n","scorecard[\"MutualInfo\"] = (\n","    scorecard[\"Mutual Information Score\"] >= mi_threshold\n",").astype(int)\n","\n","scorecard.drop(\n","    columns=\"Mutual Information Score\",\n","    inplace=True\n",")\n","\n","# -----------------------------------------------------\n","# Random Forest Score\n","# -----------------------------------------------------\n","\n","scorecard = scorecard.merge(\n","    rf,\n","    on=\"Feature\",\n","    how=\"left\"\n",")\n","\n","rf_threshold = scorecard[\"Importance\"].median()\n","\n","scorecard[\"RFImportance\"] = (\n","    scorecard[\"Importance\"] >= rf_threshold\n",").astype(int)\n","\n","scorecard.drop(\n","    columns=\"Importance\",\n","    inplace=True\n",")\n","\n","# -----------------------------------------------------\n","# Final Score\n","# -----------------------------------------------------\n","\n","scorecard[\"FinalScore\"] = (\n","\n","    scorecard[\"ChiSquare\"]\n","\n","    +\n","\n","    scorecard[\"ANOVA\"]\n","\n","    +\n","\n","    scorecard[\"MutualInfo\"]\n","\n","    +\n","\n","    scorecard[\"RFImportance\"]\n","\n",")\n","\n","# -----------------------------------------------------\n","# Recommendation\n","# -----------------------------------------------------\n","\n","scorecard[\"Recommendation\"] = scorecard[\"FinalScore\"].apply(\n","\n","    lambda x: \"Keep\" if x >= 3 else \"Review\"\n","\n",")\n","\n","scorecard = scorecard.sort_values(\n","\n","    by=\"FinalScore\",\n","\n","    ascending=False\n","\n",")\n","\n","print(\"=\"*70)\n","print(\"FEATURE SELECTION SCORECARD\")\n","print(\"=\"*70)\n","\n","print(scorecard)\n","\n","scorecard.to_csv(\n","\n","    \"Feature_Selection_Scorecard.csv\",\n","\n","    index=False\n","\n",")\n"